---
import BaseLayout from '../layouts/BaseLayout.astro'
import Wrapper from '../components/Wrapper.astro'
import Header from '../components/Header.astro'
import Button from '../components/Button.astro'
import config from '../config'
---

<BaseLayout title={`Contact | ${config.siteTitle}`}>
  <Wrapper>
    <Header />
    <div class="card">
      <h1>I'd love to hear from you!</h1>
      <p>If you have ideas or questions on any topic I covered on this site please feel free to contact me.</p>
      <!-- Netlify detects this form at deploy time; keep its name, data-netlify, honeypot and action. -->
      <form name="contact-form" method="post" data-netlify="true" data-netlify-honeypot="bot-field" action="/success">
        <p hidden>
          <label>
            Don't fill this out: <input name="bot-field" />
          </label>
        </p>
        <p>
          <label for="contact-name">
            Name
            <input name="name" id="contact-name" type="text" required />
          </label>
        </p>
        <p>
          <label for="contact-email">
            E-Mail <input name="email" id="contact-email" type="email" required />
          </label>
        </p>
        <p>
          <label for="contact-message">
            Your Message <textarea name="message" id="contact-message" required></textarea>
          </label>
        </p>
        <p>
          <Button type="submit">Send</Button>
        </p>
        <input type="hidden" name="form-name" value="contact-form" />
      </form>
    </div>
  </Wrapper>
</BaseLayout>

<style>
  form p label,
  form p input {
    display: block;
  }
  form p input {
    min-width: 275px;
    margin-top: 0.5rem;
  }
  form p textarea {
    resize: vertical;
    min-height: 150px;
    width: 100%;
    margin-top: 0.5rem;
  }
</style>
