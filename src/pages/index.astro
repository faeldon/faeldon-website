---
import BaseLayout from '../layouts/BaseLayout.astro'
import Wrapper from '../components/Wrapper.astro'
import Button from '../components/Button.astro'
import SectionTitle from '../components/SectionTitle.astro'
import Article from '../components/Article.astro'
import { getSortedPosts } from '../lib/posts'

const posts = await getSortedPosts()
---

<BaseLayout>
  <Wrapper>
    <div class="hero">
      <h1>Hi.</h1>
      <p>I&apos;m James Faeldon a software engineer based in Manila.</p>
      <a href="/contact">
        <Button big>
          <svg width="1792" height="1792" viewBox="0 0 1792 1792" xmlns="http://www.w3.org/2000/svg">
            <path d="M1764 11q33 24 27 64l-256 1536q-5 29-32 45-14 8-31 8-11 0-24-5l-453-185-242 295q-18 23-49 23-13 0-22-4-19-7-30.5-23.5t-11.5-36.5v-349l864-1059-1069 925-395-162q-37-14-40-55-2-40 32-59l1664-960q15-9 32-9 20 0 36 11z"></path>
          </svg>
          Contact
        </Button>
      </a>
    </div>
    <div class="content">
      <SectionTitle>Latest stories</SectionTitle>
      {posts.map((post) => (
        <Article post={post} />
      ))}
    </div>
  </Wrapper>
</BaseLayout>

<style>
  .content {
    grid-column: 2;
    box-shadow: 0 4px 120px rgba(0, 0, 0, 0.1);
    border-radius: 1rem;
    padding: 3rem 6rem;
    overflow: hidden;
  }
  @media (max-width: 1200px) {
    .content {
      padding: 3rem 2rem;
    }
  }
  @media (max-width: 600px) {
    .content {
      padding: 2rem 1.5rem;
    }
  }
  .hero {
    grid-column: 2;
    padding: 3rem 2rem 6rem 2rem;
    text-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    color: var(--grey-dark);
  }
  .hero p {
    font-size: 1.68rem;
    margin-top: -1rem;
  }
  @media (max-width: 1200px) {
    .hero p {
      font-size: 1.45rem;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 2rem 1rem 4rem 1rem;
    }
    .hero p {
      font-size: 1.25rem;
    }
  }
</style>
