---
import config from '../config'
---

<header>
  <div class="content">
    <a href="/">{config.siteTitle}</a>
  </div>
</header>

<style>
  header {
    background: linear-gradient(45deg, var(--primary-dark), var(--primary-lighter));
    grid-column: 1 / -1;
    margin-left: -1rem;
    margin-right: -1rem;
    padding: 2rem 2rem 5rem 2rem;
    box-shadow: inset 0px -10px 30px 0px rgba(0, 0, 0, 0.1);
  }
  .content {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  a {
    color: var(--white);
    font-size: 1.2rem;
  }
  a:hover {
    opacity: 0.85;
    color: var(--white);
  }
</style>
