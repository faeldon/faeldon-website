{
  "extends": ["config:recommended"],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "major": {
    "automerge": false
  },
  "packageRules": [
    {
      "matchPackageNames": ["/^eslint/", "/^@eslint//", "typescript-eslint"],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": ["astro", "/^@astrojs//", "prettier-plugin-astro", "eslint-plugin-astro"],
      "groupName": "astro"
    },
    {
      "matchPackageNames": ["/^@fontsource//"],
      "groupName": "fonts"
    }
  ],
  "labels": ["renovate"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 15,
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "schedule": ["before 8am on Monday"]
}
